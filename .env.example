# Training Tracker: environment variables.
# Copy to .env.local and fill in real values. NEVER commit real values;
# this repo is open source. RLS makes the anon/publishable keys safe to expose
# to the browser; the service role and Strava secrets stay server-side only.

# --- Supabase ---
# Browser-safe (public) keys. Protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only. Bypasses RLS; never expose to the client. May be empty locally.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Owner / auth ---
# The single owner is the authenticated Supabase user whose email equals this.
ADMIN_EMAIL="you@example.com"

# --- Strava (OAuth + sync). Server-side only. May be empty during build. ---
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Optional: overrides the derived OAuth callback URL. Defaults to
# <request-origin>/api/strava/callback, so localhost works with no override.
STRAVA_REDIRECT_URI=""

# --- Cron ---
# Shared secret guarding the scheduled Strava pull endpoint.
CRON_SECRET="generate-a-long-random-string"

# --- Mobile (Expo) ---
# The Expo app lives in /mobile and talks to this Next.js deployment for
# assembled payloads + Strava OAuth (/api/mobile/*). Configure these in
# mobile/.env (see mobile/.env.example); they are EXPO_PUBLIC_* only:
#   EXPO_PUBLIC_SUPABASE_URL
#   EXPO_PUBLIC_SUPABASE_ANON_KEY
#   EXPO_PUBLIC_API_BASE_URL   (this Vercel origin)
#   EXPO_PUBLIC_OWNER_EMAIL
# Strava Authorization Callback Domain stays your web host. Mobile uses
# /api/mobile/strava/callback on that same host, then deep-links to comeback://.
