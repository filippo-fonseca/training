# Training Tracker — environment variables.
# Copy to .env.local and fill in real values. NEVER commit real values;
# this repo is open source. RLS makes the anon/publishable keys safe to expose
# to the browser; the service role and Strava secrets stay server-side only.

# --- Supabase (project ref pyoscjcrsujtmnwisosc, us-east-1) ---
# Browser-safe (public) keys. Protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only. Bypasses RLS — never expose to the client. May be empty locally.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Owner / auth ---
# The single owner is the authenticated Supabase user whose email equals this.
ADMIN_EMAIL="you@example.com"

# --- Strava (OAuth + sync). Server-side only. May be empty during build. ---
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# --- Cron ---
# Shared secret guarding the scheduled Strava pull endpoint.
CRON_SECRET="generate-a-long-random-string"

# --- Site ---
# Absolute base URL of this deployment (used for OAuth redirects, widget CORS).
NEXT_PUBLIC_SITE_URL="http://localhost:3864"
